LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-openai-api-key
LLM_BASE_URL=https://api.openai.com/v1
BACKEND_URL=http://backend:5000

# Shopping recommendations (Phase 2)
# SerpAPI — Google Shopping search. Free: 100 searches/mo, no card.
# Sign up: https://serpapi.com/users/sign_up — key at https://serpapi.com/manage-api-key
SERPAPI_KEY=your-serpapi-key
# Tavily — fallback web search with include_domains filter. Free: 1000 credits/mo.
# Sign up: https://app.tavily.com
TAVILY_KEY=your-tavily-key

# Shared secret between backend ↔ ai-service. If set, ai-service requires the
# matching X-Internal-Token header on every /recommend-purchases call.
# Leave blank in dev; set to a random string in production (matching value
# must be set as AI_SERVICE_TOKEN on the backend).
AI_SERVICE_TOKEN=
